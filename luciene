<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cabana Garibalde | Luciene</title><style>
*{box-sizing:border-box}body{margin:0;background:#f6f2e9;color:#193c2c;font:15px system-ui,Arial}header{background:#173e2c;color:#fff;padding:26px 20px;border-radius:0 0 22px 22px}main{max-width:650px;margin:20px auto;padding:0 15px}h1{font:29px Georgia;margin:0 0 5px}h2{font:24px Georgia}section,.card{background:white;padding:18px;border-radius:16px;margin:13px 0;box-shadow:0 6px 20px #163b2b12}input,select,button{font:inherit;padding:12px;border-radius:9px;border:1px solid #d4dfd7;width:100%;margin:7px 0}button{background:#245b41;color:white;font-weight:700;border:0;cursor:pointer}button:disabled{opacity:.55}.hidden{display:none!important}.muted{color:#687a6e;font-size:13px}.tabs{display:flex;gap:8px}.tabs button{flex:1;background:#e5ece4;color:#204631}.tabs button.active{background:#245b41;color:white}.tag{font-size:12px;background:#e7eee5;border-radius:20px;padding:4px 9px}.row{display:flex;justify-content:space-between;align-items:center;gap:10px}.month{display:flex;align-items:center;gap:10px}.month button{width:45px}.month strong{flex:1;text-align:center}.grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}.day{min-height:43px;font-size:12px;background:#edf3ed;color:#1d4631;padding:6px 1px;margin:0}.day.booked{background:#285a43;color:white}.day.done{background:#d5e8dc;color:#20553c}.day.empty{visibility:hidden}.day.selected{outline:3px solid #c49d57}.day:disabled{cursor:default}.detail{border-top:1px solid #e1e8e1;margin-top:10px;padding-top:10px}#msg{min-height:24px}a{color:#215e40}
</style></head><body><header><div class="row"><div><h1>Cabana Garibalde</h1><div>Painel da Luciene • Limpezas</div></div><button id="sair" class="hidden" style="width:auto;background:#ffffff24">Sair</button></div></header><main>
<section id="login"><h2>Acesso da funcionária</h2><form id="formLogin"><label>E-mail<input id="email" type="email" value="medeirosluciene372@gmail.com" required autocomplete="username"></label><label>Senha<input id="senha" type="password" required autocomplete="current-password"></label><button>Entrar</button></form></section>
<div id="app" class="hidden"><div class="tabs"><button data-view="agenda" class="active">📅 Calendário</button><button data-view="limpezas">🧹 Registrar limpeza</button></div>
<section id="agenda"><h2>Agenda das cabanas</h2><p class="muted">Verde-escuro: locada. Verde-claro: limpeza registrada. Toque em um dia para consultar.</p><select id="cabana"><option value="1">Cabana 1</option><option value="2">Cabana 2</option><option value="3">Cabana 3</option></select><div class="month"><button id="anterior">‹</button><strong id="mes"></strong><button id="proximo">›</button></div><div class="grid" id="grade"></div><div class="card" id="detalhe">Selecione um dia.</div></section>
<section id="limpezas" class="hidden"><h2>Registrar limpeza</h2><p class="muted">Escolha a hospedagem encerrada. Cada limpeza registrada vale R$ 50,00 e só pode ser registrada uma vez.</p><div id="lista"></div></section></div><p id="msg" role="status"></p></main>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script><script>
'use strict';const $=id=>document.getElementById(id),api=window.supabase.createClient('https://rntciuxfndgeazwsuwxm.supabase.co','sb_publishable_TDivET7FHAKNj_Z8D2Fi5A_gaAGC9JQ');let reservas=[],ano=new Date().getFullYear(),mes=new Date().getMonth(),selecionado='',aba='agenda';const hoje=()=>{const parts=new Intl.DateTimeFormat('en-US',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());const v=Object.fromEntries(parts.map(x=>[x.type,x.value]));return `${v.year}-${v.month}-${v.day}`};const fmt=s=>s.split('-').reverse().join('/');const msg=s=>$('msg').textContent=s||'';
async function carregar(){msg('Carregando agenda...');const {data,error}=await api.rpc('garibalde_agenda_funcionaria');if(error){msg('Não foi possível consultar a agenda: '+error.message);return}reservas=data||[];render();msg('Agenda atualizada.')}
function render(){document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===aba));$('agenda').classList.toggle('hidden',aba!=='agenda');$('limpezas').classList.toggle('hidden',aba!=='limpezas');if(aba==='agenda')calendario();else lista()}
function calendario(){const g=$('grade');g.replaceChildren();$('mes').textContent=new Date(ano,mes,1).toLocaleDateString('pt-BR',{month:'long',year:'numeric'});for(const s of ['D','S','T','Q','Q','S','S']){let d=document.createElement('strong');d.style.textAlign='center';d.textContent=s;g.append(d)}for(let i=0;i<new Date(ano,mes,1).getDay();i++){let d=document.createElement('div');d.className='day empty';g.append(d)}for(let d=1;d<=new Date(ano,mes+1,0).getDate();d++){const iso=`${ano}-${String(mes+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`,r=reservas.filter(x=>String(x.cabana_id)===$('cabana').value&&x.checkin<=iso&&iso<x.checkout);let b=document.createElement('button');b.className='day'+(r.length?(r.every(x=>x.limpeza_realizada)?' done':' booked'):'')+(selecionado===iso?' selected':'');b.textContent=d;b.onclick=()=>{selecionado=iso;calendario()};g.append(b)}const box=$('detalhe');box.replaceChildren();if(!selecionado){box.textContent='Selecione um dia.';return}let r=reservas.filter(x=>String(x.cabana_id)===$('cabana').value&&x.checkin<=selecionado&&selecionado<x.checkout);let t=document.createElement('b');t.textContent=fmt(selecionado)+' — Cabana '+$('cabana').value;box.append(t);for(const x of r){let p=document.createElement('p');p.textContent=`Locada de ${fmt(x.checkin)} até ${fmt(x.checkout)} (saída)`;box.append(p)}if(!r.length){let p=document.createElement('p');p.textContent='Sem hospedagem nesta data.';box.append(p)}}
function lista(){const el=$('lista');el.replaceChildren();const rs=reservas.filter(r=>r.checkout<=hoje()).sort((a,b)=>b.checkout.localeCompare(a.checkout));if(!rs.length){el.textContent='Nenhuma hospedagem encerrada disponível.';return}for(const r of rs){const card=document.createElement('div');card.className='card';let title=document.createElement('b');title.textContent=`Cabana ${r.cabana_id} — saída ${fmt(r.checkout)}`;card.append(title);let p=document.createElement('p');p.className='muted';p.textContent=`Hospedagem: ${fmt(r.checkin)} a ${fmt(r.checkout)} • R$ 50,00`;card.append(p);let b=document.createElement('button');b.textContent=r.limpeza_realizada?'✓ Limpeza já registrada':'Registrar limpeza e abrir WhatsApp';b.disabled=r.limpeza_realizada;b.onclick=()=>registrar(r,b);card.append(b);el.append(card)}}
async function registrar(r,b){if(!confirm(`Confirmar limpeza realizada na Cabana ${r.cabana_id}, referente à saída de ${fmt(r.checkout)}?`))return;b.disabled=true;msg('Salvando limpeza...');const {data,error}=await api.rpc('garibalde_registrar_limpeza',{p_reserva_id:r.reserva_id});if(error){msg('Não foi possível salvar: '+error.message);b.disabled=false;return}r.limpeza_realizada=true;render();msg('Limpeza salva. Abrindo WhatsApp; toque em Enviar.');const dataHora=new Date(data?.[0]?.registrada_em||Date.now()).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'});const texto=`🧹 *CABANA GARIBALDE — LIMPEZA REALIZADA*
🏡 Cabana: ${r.cabana_id}
👩 Funcionária: Luciene Medeiros do Nascimento
📅 Saída da hospedagem: ${fmt(r.checkout)}
🕒 Registro: ${dataHora}
💰 Valor: R$ 50,00
✅ Limpeza concluída e cadastrada.`;const link='https://wa.me/5564992145285?text='+encodeURIComponent(texto);const a=document.createElement('a');a.href=link;a.target='_blank';a.rel='noopener noreferrer';a.textContent='Abrir WhatsApp para enviar o aviso';a.style.display='block';a.style.padding='12px';$('msg').replaceChildren(document.createTextNode('Limpeza salva! '),a);window.open(link,'_blank','noopener,noreferrer')}
$('formLogin').onsubmit=async e=>{e.preventDefault();msg('Entrando...');const {error}=await api.auth.signInWithPassword({email:$('email').value,password:$('senha').value});if(error){msg('Erro no login: '+error.message);return}iniciar()};async function iniciar(){const {data}=await api.auth.getSession();const ok=!!data.session;$('login').classList.toggle('hidden',ok);$('app').classList.toggle('hidden',!ok);$('sair').classList.toggle('hidden',!ok);if(ok)await carregar()};$('sair').onclick=async()=>{await api.auth.signOut();reservas=[];iniciar()};document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{aba=b.dataset.view;render()});$('anterior').onclick=()=>{if(--mes<0){mes=11;ano--}selecionado='';render()};$('proximo').onclick=()=>{if(++mes>11){mes=0;ano++}selecionado='';render()};$('cabana').onchange=()=>{selecionado='';render()};iniciar();
</script></body></html>
